# Flask session signing key.
# Generate a long random value locally. Never commit the real value.
APP_SECRET_KEY=replace-with-a-long-random-secret

# Optional bootstrap administrator created only when usuarios.json does not exist.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# External dashboard destination for non-admin users.
DASHBOARD_URL=https://example.com/dashboard

# Local server configuration.
HOST=127.0.0.1
PORT=5000

# Use true only behind HTTPS in production.
SESSION_COOKIE_SECURE=false
